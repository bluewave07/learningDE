{
  "name": "learningde",
  "version": "1.2.0",
  "description": "Learn German at B2 level: 3,000 everyday and IT words, daily mandatory shadowing, stories, role-play and spaced repetition. Runs offline in the browser.",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "npx --yes http-server -c-1 -p 8000 .",
    "build:sw": "node scripts/build-sw.mjs",
    "validate": "node scripts/validate.mjs && node scripts/build-sw.mjs --check",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "check": "npm run validate && npm test"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1"
  },
  "engines": {
    "node": ">=18"
  }
}
